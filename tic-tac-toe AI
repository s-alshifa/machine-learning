def win(b, p):
    w = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
    return any(b[i]==b[j]==b[k]==p for i,j,k in w)

def ai(b):
    for p in "OX":  # O = win, X = block
        for i in range(9):
            if b[i]==" ":
                b[i]=p
                if win(b,p):
                    b[i]="O"
                    return
                b[i]=" "
    for i in [4,0,2,6,8,1,3,5,7]:
        if b[i]==" ":
            b[i]="O"; return

b = [" "] * 9

while True:
    print(b[0:3], "\n", b[3:6], "\n", b[6:9])
    m = int(input("1-9: ")) - 1
    if b[m]!=" ": continue
    b[m]="X"

    if win(b,"X"): print("You win"); break
    if " " not in b: print("Draw"); break

    ai(b)

    if win(b,"O"): print("AI wins"); break
    if " " not in b: print("Draw"); break
